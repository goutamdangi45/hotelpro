{
  "info": {
    "name": "HotelPro API Collection",
    "description": "Comprehensive REST API Collection for HotelPro - Hotel Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Guest",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1 (555) 123-4567\",\n  \"idProofType\": \"Passport\",\n  \"idProofNumber\": \"USA-982103\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hotelpro.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Get All Rooms (with filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms?roomType=Deluxe&status=Available",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"],
              "query": [
                { "key": "roomType", "value": "Deluxe" },
                { "key": "status", "value": "Available" }
              ]
            }
          }
        },
        {
          "name": "Get Featured Rooms",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/rooms/featured", "host": ["{{baseUrl}}"], "path": ["api", "rooms", "featured"] }
          }
        },
        {
          "name": "Create Room (Admin/Staff)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"501\",\n  \"title\": \"Penthouse Sky Oasis\",\n  \"roomType\": \"Presidential Suite\",\n  \"pricePerNight\": 750,\n  \"capacity\": { \"adults\": 4, \"children\": 2 },\n  \"bedType\": \"Two King Beds\",\n  \"floor\": 5,\n  \"sizeSqFt\": 1200,\n  \"amenities\": [\"Private Pool\", \"Butler Service\", \"Oceanfront Balcony\", \"Smart TV\", \"Wi-Fi\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/rooms", "host": ["{{baseUrl}}"], "path": ["api", "rooms"] }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"checkInDate\": \"2026-11-01\",\n  \"checkOutDate\": \"2026-11-04\",\n  \"guests\": { \"adults\": 2, \"children\": 0 },\n  \"paymentMethod\": \"Credit Card\",\n  \"specialRequests\": \"Quiet corner room\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/my-bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "my-bookings"] }
          }
        },
        {
          "name": "Update Booking Status (Check In / Check Out)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingStatus\": \"Checked-In\",\n  \"keyCardIssued\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard & Metrics",
      "item": [
        {
          "name": "Get Operations KPI Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "stats"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ]
}
